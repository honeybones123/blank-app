{
  "schema": "module_contract_registry.v1",
  "levels": {
    "L0": "compile/import only; allowed only for explicitly low-risk wrappers or compatibility shims",
    "L1": "smoke-backed contract proving import/render/shape ownership",
    "L2": "behavioral contract proving stable input/output invariants",
    "L3": "parity contract proving old-vs-new behavior during extraction or migration",
    "L4": "domain contract with explicit rules, forbidden behavior, snapshots, lock verifier, or family contract"
  },
  "inventory": {
    "include_roots": [
      {
        "path": ".",
        "recursive": false,
        "glob": "*.py"
      },
      {
        "path": "ui",
        "recursive": true,
        "glob": "*.py"
      },
      {
        "path": "design_brain",
        "recursive": true,
        "glob": "*.py"
      },
      {
        "path": "calculations",
        "recursive": true,
        "glob": "*.py"
      }
    ],
    "exclude_globs": [
      "__pycache__/**",
      ".git/**",
      ".codex/**",
      ".agents/**",
      "artifacts/**",
      "outputs/**",
      "tools/**",
      "apps/**",
      "streamlit_components/**",
      "*-Elli\u2019s MacBook Pro.py",
      "*-Elli's MacBook Pro.py"
    ]
  },
  "default_policy": {
    "unclassified_modules_are_failures": true,
    "missing_evidence_is_gap": true
  },
  "family_contracts": {
    "bending_and_shear_fail_govern": {
