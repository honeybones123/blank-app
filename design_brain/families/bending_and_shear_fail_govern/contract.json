{
  "schema": "design_brain.family_contract.v1",
  "family_identity": {
    "family_id": "COMBINED_BENDING_SHEAR_FAIL_GOVERNS",
    "runtime_family_id": "COMBINED_BENDING_SHEAR_FAIL",
    "package": "design_brain.families.bending_and_shear_fail_govern",
    "runtime_module": "design_brain.families.bending_and_shear_fail_govern.runtime",
    "legacy_delegate": "design_brain.families.combined_bending_shear_fail.CombinedBendingShearFailFamily",
    "public_api": "evaluate_bending_and_shear_fail_govern"
  },
  "selection_boundary": {
    "starts_after": "SelectedFamily == COMBINED_BENDING_SHEAR_FAIL",
    "runtime_may_assume": [
      "bending underdesign exists",
      "shear underdesign exists",
      "this is the selected governing family"
    ],
    "must_not": [
      "perform classification",
      "choose another family",
      "override family selection",
      "re-rank family ownership",
      "perform family arbitration"
    ],
    "owned_by_shared_family_chooser": [
      "family selection",
      "family arbitration",
      "family priority"
    ]
  },
  "entry_contract": {
    "selected_family_id": "COMBINED_BENDING_SHEAR_FAIL",
    "validate_inputs_without_reclassification": true
  },
  "inputs_contract": {
    "input_type": "CombinedBendingShearFailInputs",
    "required_groups": [
      "geometry",
      "reinforcement",
      "material_properties",
      "actions",
      "constraints",
      "bending_fail_candidates",
      "shear_fail_candidates"
    ],
    "forbidden_state": [
      "session state",
      "UI state",
      "publication state",
      "CTA state",
      "family chooser state except already-selected family identity"
    ]
  },
  "family_result_schema": {
    "result_type": "FamilyResult",
    "required_fields": [
      "status",
      "selected_recommendation",
      "candidate_repairs",
      "exhausted_reason",
      "evidence"
    ],
    "evidence_required_fields": [
      "selection_boundary",
      "candidate_source_proof",
      "target_band_refinement_proof",
      "combined_merge_trace",
      "accepted_candidate_evidence",
      "rejected_candidate_evidence",
      "ranking_evidence",
      "exact_stop_proof",
      "exhausted_proof",
      "ownership_proof",
      "contract_version"
    ]
  },
  "ownership_contract": {
    "combined_family_owns": [
      "combined candidate merge",
      "combined candidate ranking",
      "combined selected recommendation",
      "combined exact stop proof",
      "combined exhausted proof",
      "combined recommendation evidence"
    ],
    "bending_fail_governs_owns": [
      "bending repair ladder",
      "bending candidate generation",
      "bending exact-stop proof",
      "bending exhausted proof",
      "bending repair evidence"
    ],
    "shear_fail_governs_owns": [
      "shear repair ladder",
      "shear candidate generation",
      "shear exact-stop proof",
      "shear exhausted proof",
      "shear repair evidence"
    ],
    "shared_systems_own": [
      "family selection",
      "family arbitration",
      "publication",
      "CTA generation",
      "CTA rendering",
      "apply routing",
      "session state",
      "UI rendering",
      "recommendation publication",
      "source precedence",
      "user wording"
    ]
  },
  "candidate_source_contract": {
    "allowed_sources": [
      "BENDING_FAIL_GOVERNS",
      "SHEAR_FAIL_GOVERNS",
      "APPROVED_COMBINED_MERGE_RULE"
    ],
    "must_not_duplicate_ladders": true,
    "approved_merge_rules": [
      "combine one bending-fail candidate with one shear-fail candidate",
      "use a geometry candidate that affects both checks when it came from a locked source candidate",
      "use explicit shared update keys from source candidates without inventing formula ladders",
      "target-band refinement may only adjust approved shared geometry, bending reinforcement, and shear reinforcement update keys"
    ],
    "target_band_refinement_lane": {
      "lane_id": "APPROVED_COMBINED_TARGET_BAND_REFINEMENT",
      "source_family_id": "APPROVED_COMBINED_MERGE_RULE",
      "allowed": true,
      "purpose": "search for a combined repair that keeps both bending and shear inside target band after a safe approved merge seed is too conservative",
      "must_use_only_contract_update_keys": true,
      "must_not_duplicate_source_family_ladders": true,
      "candidate_generation_owner": "COMBINED_BENDING_SHEAR_FAIL_GOVERNS",
      "evaluation_owner": "shared/page candidate evaluator boundary",
      "exact_stop_requires_evaluated_target_band": true,
      "fallback_when_no_target_band_candidate": "best compliant combined repair with specific reason and target-band miss proof"
    }
  },
  "success_contract": {
    "valid_combined_repair_requires": [
      "bending utilisation improves",
      "shear utilisation improves",
      "bending becomes compliant",
      "shear becomes compliant",
      "all code constraints remain satisfied",
      "all detailing constraints remain satisfied",
      "all constructability constraints remain satisfied"
    ],
    "partial_repair_candidates_are_diagnostic_only": true
  },
  "target_band": {
    "bending_lower": 0.85,
    "bending_upper": 1.0,
    "shear_lower": 0.85,
    "shear_upper": 1.0,
    "preferred": "both bending and shear inside target band",
    "fallback": "best compliant combined repair with specific reason",
    "candidate_lane": "APPROVED_COMBINED_TARGET_BAND_REFINEMENT"
  },
  "interaction_contract": {
    "geometry_update_keys": [
      "D",
      "beam_depth",
      "beam_depth_mm",
      "b",
      "bw",
      "beam_width",
      "beam_width_mm"
    ],
    "bending_reinforcement_update_keys": [
      "bot1_count",
      "db_bot_1",
      "bot2_count",
      "db_bot_2",
      "bot_row_count",
      "bot_row_1_bars",
      "bot_row_1_dia",
      "bot_row_2_bars",
      "bot_row_2_dia"
    ],
    "shear_reinforcement_update_keys": [
      "lig_d",
      "lig_legs",
      "s_lig"
    ],
    "geometry_recheck_required": [
      "bending",
      "shear",
      "minimum reinforcement",
      "geometry ratio",
      "constructability"
    ],
    "bending_reinforcement_recheck_required": [
      "bending capacity",
      "minimum bending reinforcement",
      "constructability",
      "congestion"
    ],
    "shear_reinforcement_recheck_required": [
      "shear capacity",
      "shear detailing",
      "constructability",
      "congestion"
    ]
  },
  "exact_stop": {
    "allowed_when": [
      "bending compliant",
      "shear compliant",
      "bending inside target band",
      "shear inside target band",
      "no higher-ranked combined candidate exists"
    ]
  },
  "exhausted": {
    "requires": [
      "all bending-fail candidates attempted",
      "all shear-fail candidates attempted",
      "all approved combined-merge combinations attempted",
      "no valid combined repair exists",
      "specific blocker exists"
    ],
    "valid_reasons": [
      "bending repair exhausted",
      "shear repair exhausted",
      "combined geometry constraints exhausted",
      "constructability constraints exhausted",
      "code compliance boundary reached"
    ],
    "generic_exhausted_message_prohibited_when_specific_blocker_exists": true
  },
  "ranking": {
    "ordered_criteria": [
      "repairs both bending and shear",
      "both checks inside target band",
      "worst utilisation closest to target band",
      "smallest geometry increase",
      "smallest reinforcement increase",
      "constructability",
      "cost proxy"
    ],
    "invalid_before_ranking": [
      "bending remains underdesigned",
      "shear remains underdesigned",
      "code compliance violated",
      "detailing violated",
      "constructability violated"
    ]
  },
  "lane_proof_policies": {
    "candidate_source": {
      "allowed_sources": [
        "BENDING_FAIL_GOVERNS",
        "SHEAR_FAIL_GOVERNS",
        "APPROVED_COMBINED_MERGE_RULE"
      ],
      "forbidden": [
        "combined family generated bending ladder",
        "combined family generated shear ladder"
      ]
    },
    "target_band_refinement": {
      "lane_id": "APPROVED_COMBINED_TARGET_BAND_REFINEMENT",
      "allowed_source": "APPROVED_COMBINED_MERGE_RULE",
      "required_proof": [
        "approved update keys only",
        "all generated candidates evaluated",
        "target-band candidates counted",
        "safe fallback candidates counted",
        "fallback reason emitted when no target-band candidate exists"
      ],
      "exact_stop_forbidden_when": [
        "selected repair is compliant but bending is outside target band",
        "selected repair is compliant but shear is outside target band",
        "target-band candidate count is zero"
      ]
    },
    "combined_repair_validity": {
      "case_a": {
        "candidate": "fixes both bending and shear",
        "expected": "candidate may be ranked"
      },
      "case_b": {
        "candidate": "fixes bending only",
        "expected": "candidate not selected"
      },
      "case_c": {
        "candidate": "fixes shear only",
        "expected": "candidate not selected"
      }
    },
    "geometry_interaction": {
      "depth_candidate_expected_rechecks": [
        "bending",
        "shear",
        "minimum reinforcement",
        "geometry ratio",
        "constructability"
      ],
      "width_candidate_expected_rechecks": [
        "bending",
        "shear",
        "minimum reinforcement",
        "geometry ratio",
        "constructability"
      ]
    },
    "reinforcement_interaction": {
      "bending_reinforcement_expected_rechecks": [
        "bending capacity",
        "minimum bending reinforcement",
        "constructability",
        "congestion"
      ],
      "shear_reinforcement_expected_rechecks": [
        "shear capacity",
        "shear detailing",
        "constructability",
        "congestion"
      ]
    },
    "terminal": {
      "exact_stop_allowed_when": [
        "bending compliant",
        "shear compliant",
        "bending inside target band",
        "shear inside target band",
        "no higher-ranked combined candidate exists"
      ],
      "exhausted_requires": [
        "all bending-fail candidates attempted",
        "all shear-fail candidates attempted",
        "all approved combined-merge combinations attempted",
        "no valid combined repair exists",
        "specific blocker exists"
      ]
    }
  },
  "shared_exclusions": [
    "family selection",
    "family arbitration",
    "publication",
    "CTA generation",
    "CTA rendering",
    "apply routing",
    "one-click orchestration",
    "session state",
    "UI rendering",
    "recommendation publication",
    "source precedence",
    "visible wording",
    "user wording",
    "debug rendering"
  ],
  "lock_verification": {
    "required_verifiers": [
      "tools/verification/families/bending_and_shear_fail_govern_contract_check.py"
    ],
    "required_gates": [
      "COMBINED_BENDING_SHEAR_FAIL_GOVERNS contract check",
      "combined candidate merge boundary",
      "combined source and interaction lane proofs",
      "combined merge runtime snapshot",
      "replacement audit",
      "cutover verifier",
      "lock verifier"
    ]
  }
}
