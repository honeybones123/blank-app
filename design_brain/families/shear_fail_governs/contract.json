{
  "schema": "design_brain.family_contract.v1",
  "family_identity": {
    "family_id": "SHEAR_FAIL_GOVERNS",
    "package": "design_brain.families.shear_fail_governs",
    "legacy_delegate": "design_brain.families.shear_fail.ShearFailFamily",
    "public_api": "evaluate_shear_fail_governs"
  },
  "classification": {
    "entry_condition": "shear underdesign governs",
    "governs_when": [
      "shear utilisation exceeds allowable limit",
      "shear repair is required",
      "shear failure is the governing published outcome"
    ],
    "must_not_govern_when": [
      "bending-only failure governs",
      "combined bending and shear failure governs",
      "target band is already reached",
      "locked-no-repair outcome is required",
      "exact-stop proven outcome is required"
    ],
    "allowed_competing_families": [
      "BENDING_FAIL_GOVERNS",
      "BENDING_AND_SHEAR_FAIL_GOVERN",
      "SHEAR_FAIL_BENDING_OVERDESIGN_GOVERNS",
      "LOCKED_NO_REPAIR",
      "EXACT_STOP_PROVEN"
    ]
  },
  "required_family_inputs": {
    "geometry": [
      "beam width",
      "beam depth",
      "effective depth",
      "depth/width ratio",
      "geometry locked status"
    ],
    "reinforcement": [
      "ligature spacing",
      "ligature diameter",
      "ligature leg count",
      "reinforcement locked status",
      "spacing/detailing status"
    ],
    "material_properties": [
      "concrete strength",
      "steel strength",
      "shear capacity parameters"
    ],
    "actions": [
      "design shear action",
      "bending action",
      "serviceability action state"
    ],
    "constraints": [
      "target utilisation band",
      "minimum spacing",
      "maximum practical diameter",
      "width/depth growth permissions",
      "locked/no-repair conditions"
    ]
  },
  "family_result_schema": {
    "result_type": "FamilyResult",
    "required_fields": [
      "status",
      "selected_recommendation",
      "candidate_repairs",
      "exhausted_reason",
      "evidence"
    ],
    "evidence_required_fields": [
      "entry_condition",
      "ladder_trace",
      "accepted_lane_evidence",
      "rejected_lane_evidence",
      "ranking_evidence",
      "terminal_status",
      "contract_version"
    ]
  },
  "internal_strategy_ladder": {
    "family_id": "SHEAR_FAIL_GOVERNS",
    "entry_condition": "shear underdesign governs",
    "lanes": [
      {
        "lane_index": 0,
        "lane_id": "SPACING_REDUCTION",
        "title": "Spacing reduction",
        "purpose": "Increase shear reinforcement density by reducing ligature spacing within detailing limits.",
        "required_evidence": [
          "spacing before",
          "spacing after",
          "shear utilisation before",
          "shear utilisation after",
          "spacing/detailing status"
        ],
        "search_policy": {
          "spacing_values_mm": [
            300,
            250,
            200,
            175,
            150,
            125,
            100
          ]
        },
        "failure_transition": "BAR_SIZE_INCREASE"
      },
      {
        "lane_index": 1,
        "lane_id": "BAR_SIZE_INCREASE",
        "title": "Bar size increase",
        "purpose": "Increase ligature diameter after spacing reduction is blocked or insufficient.",
        "required_evidence": [
          "diameter before",
          "diameter after",
          "shear utilisation before",
          "shear utilisation after",
          "detailing status"
        ],
        "search_policy": {
          "bar_size_labels": [
            "N10",
            "N12",
            "N16"
          ],
          "bar_diameters_mm": [
            10,
            12,
            16
          ],
          "restart_after_each_size": [
            "SPACING_REDUCTION"
          ],
          "restart_spacing_values_mm": [
            300,
            250,
            200,
            175,
            150,
            125,
            100
          ]
        },
        "failure_transition": "DEPTH_INCREASE_RESTART_REINFORCEMENT_SEARCH"
      },
      {
        "lane_index": 2,
        "lane_id": "DEPTH_INCREASE_RESTART_REINFORCEMENT_SEARCH",
        "title": "Depth increase plus reinforcement restart",
        "purpose": "Increase depth when reinforcement-only changes are insufficient, then restart the reinforcement search.",
        "required_evidence": [
          "depth before",
          "depth after",
          "shear utilisation before",
          "shear utilisation after",
          "restart reinforcement search evidence"
        ],
        "search_policy": {
          "increment_mm": 25,
          "restart_after_each_depth_change": [
            "SPACING_REDUCTION",
            "BAR_SIZE_INCREASE"
          ],
          "restart_spacing_values_mm": [
            300,
            250,
            200,
            175,
            150,
            125,
            100
          ],
          "restart_bar_size_labels": [
            "N10",
            "N12",
            "N16"
          ]
        },
        "success_transition": "SPACING_REDUCTION",
        "failure_transition": "WIDTH_INCREASE_RESTART_REINFORCEMENT_SEARCH"
      },
      {
        "lane_index": 3,
        "lane_id": "WIDTH_INCREASE_RESTART_REINFORCEMENT_SEARCH",
        "title": "Width increase plus reinforcement restart",
        "purpose": "Increase width where spacing/detailing or geometry blocks prior strategies, then restart the reinforcement search.",
        "required_evidence": [
          "width before",
          "width after",
          "shear utilisation before",
          "shear utilisation after",
          "restart reinforcement search evidence"
        ],
        "search_policy": {
          "increment_mm": 25,
          "restart_after_each_width_change": [
            "SPACING_REDUCTION",
            "BAR_SIZE_INCREASE"
          ],
          "restart_spacing_values_mm": [
            300,
            250,
            200,
            175,
            150,
            125,
            100
          ],
          "restart_bar_size_labels": [
            "N10",
            "N12",
            "N16"
          ]
        },
        "success_transition": "SPACING_REDUCTION",
        "failure_transition": "LEG_COUNT_INCREASE_RESTART_REINFORCEMENT_SEARCH"
      },
      {
        "lane_index": 4,
        "lane_id": "LEG_COUNT_INCREASE_RESTART_REINFORCEMENT_SEARCH",
        "title": "Leg count increase plus reinforcement restart",
        "purpose": "Increase ligature leg count after spacing, diameter, depth, and width strategies are blocked or insufficient.",
        "required_evidence": [
          "leg count before",
          "leg count after",
          "shear utilisation before",
          "shear utilisation after",
          "restart reinforcement search evidence"
        ],
        "search_policy": {
          "leg_counts": [
            2,
            4,
            6
          ],
          "restart_after_each_leg_count_change": [
            "SPACING_REDUCTION",
            "BAR_SIZE_INCREASE"
          ],
          "restart_spacing_values_mm": [
            300,
            250,
            200,
            175,
            150,
            125,
            100
          ],
          "restart_bar_size_labels": [
            "N10",
            "N12",
            "N16"
          ]
        },
        "success_transition": "SPACING_REDUCTION",
        "failure_transition": "EXACT_STOP"
      },
      {
        "lane_index": 5,
        "lane_id": "EXACT_STOP",
        "title": "Exact stop",
        "purpose": "Stop when the target band is achieved or no better valid move is available.",
        "required_evidence": [
          "target band status",
          "accepted recommendation evidence",
          "exhausted lane evidence"
        ],
        "terminal_policy": {
          "exact_stop_shear_utilisation_lower": 0.85,
          "exact_stop_shear_utilisation_upper": 1.0
        },
        "output": "EXACT_STOP"
      },
      {
        "lane_index": 6,
        "lane_id": "EXHAUSTED",
        "title": "Exhausted",
        "purpose": "Record that every contract lane has been attempted or blocked.",
        "required_evidence": [
          "exhausted lane list",
          "blocked lane list",
          "last evaluated candidate"
        ],
        "terminal_policy": {
          "requires_all_strategies_attempted": true
        },
        "output": "EXHAUSTED"
      },
      {
        "lane_index": 7,
        "lane_id": "NO_VALID_REPAIR",
        "title": "No valid repair",
        "purpose": "Return a no-repair family result when shear still fails and no legal repair remains.",
        "required_evidence": [
          "failed shear utilisation",
          "exhausted ladder",
          "blocked reasons"
        ],
        "terminal_policy": {
          "requires_all_branches_exhausted": true,
          "requires_constraints_prohibit_remaining_repairs": true
        },
        "output": "NO_VALID_REPAIR"
      }
    ],
    "ranking": {
      "ordered_criteria": [
        "target band achieved",
        "smallest geometry change",
        "smallest reinforcement increase",
        "constructability",
        "cost proxy"
      ]
    },
    "required_outputs": [
      "status",
      "selected_recommendation",
      "candidate_repairs",
      "exhausted_reason",
      "evidence"
    ],
    "global_family_rules": [
      "The contract ladder order is deterministic.",
      "Depth increase restarts reinforcement search.",
      "Width increase restarts reinforcement search.",
      "Leg count increase restarts reinforcement search.",
      "Exactly one final family outcome is permitted: selected recommendation, exact stop, exhausted, or no valid repair.",
      "CTA rendering, publication, apply routing, UI/session, and source precedence are excluded from family ownership."
    ]
  },
  "repair_ladder": {
    "contract_role": "current_live_regression_snapshot_until_contract_runtime_cutover",
    "required_lanes": [
      "spacing_reduction_first",
      "ligature_diameter_increase_with_spacing_restart",
      "width_increase_with_diameter_and_spacing_restart"
    ],
    "must_preserve_order": true,
    "locked_snapshot_fields": [
      "family_id",
      "repair_ladder_hash",
      "stage_plan_order",
      "candidate_count",
      "candidate_indexes",
      "candidate_labels",
      "update_payload_surfaces",
      "spacing_values_tried",
      "lig_diameters_tried",
      "widths_tried",
      "restart_points",
      "restart_rule",
      "no_candidate_stop_reason",
      "final_result_summary",
      "first_spec",
      "last_spec"
    ],
    "expected_ladder_snapshots": {
      "geometry_unlocked_ladder": {
        "geometry_locked": false,
        "candidate_count": 180,
        "repair_ladder_hash": "0817401d18373ccb7637be553007f273119d32afb41f38eb72292c1ba3367ecc",
        "spacing_values_tried": [
          100.0,
          125.0,
          150.0,
          175.0
        ],
        "lig_diameters_tried": [
          12,
          16,
          20,
          24,
          28,
          32,
          36,
          40
        ],
        "widths_tried": [
          450.0,
          500.0,
          550.0,
          600.0
        ],
        "no_candidate_stop_reason": "b:D = 1:1 reached; depth/combined escalation required if shear still fails"
      },
      "geometry_locked_ladder": {
        "geometry_locked": true,
        "candidate_count": 36,
        "repair_ladder_hash": "ca2a3cf295caeb61df88c932e9c8088c84efd85775fac5bd26a3fbfbfc51662b",
        "spacing_values_tried": [
          100.0,
          125.0,
          150.0,
          175.0
        ],
        "lig_diameters_tried": [
          12,
          16,
          20,
          24,
          28,
          32,
          36,
          40
        ],
        "widths_tried": [],
        "no_candidate_stop_reason": "geometry locked; legal no-repair proof required if reinforcement ladder fails"
      }
    },
    "restart_rule": "After every lig diameter increase or beam-width increase, restart the repair ladder from spacing reduction.",
    "ranking_rule": "Evaluate spacing-first contract order and stop on the first fully compliant executor-backed shear repair."
  },
  "blockers": {
    "allowed": [
      "min_shear_reo",
      "spacing",
      "ligature_diameter",
      "geometry_width",
      "locked_geometry",
      "b_to_d_limit",
      "combined_escalation_required",
      "no_candidate_found",
      "target_band_exhausted"
    ],
    "not_top_level_families": [
      "min_shear_reo",
      "spacing",
      "ligature_diameter",
      "geometry_width",
      "b_to_d_limit"
    ]
  },
  "shared_exclusions": [
    "CTA rendering",
    "CTA source precedence",
    "publication",
    "selected-family publication gate",
    "apply routing",
    "one-click orchestration",
    "visible wording",
    "UI rendering",
    "session state",
    "debug rendering"
  ],
  "lock_verification": {
    "required_verifiers": [
      "tools/verification/families/shear_fail_governs_locked_regression.py",
      "tools/verification/families/shear_fail_governs_contract_check.py"
    ],
    "required_snapshots": [
      "geometry_unlocked_ladder",
      "geometry_locked_ladder"
    ],
    "required_gates": [
      "compileall",
      "governing_family_architecture_check",
      "shear_fail_governs_api_check",
      "publication_snapshot",
      "C1_C2_C3_product_gates",
      "SHEAR_COMBINED_BENDING_regressions",
      "targeted_fingerprint_update_resolution_scan"
    ]
  }
}
