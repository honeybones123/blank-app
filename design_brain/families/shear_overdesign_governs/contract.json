{
  "schema": "design_brain.family_contract.v1",
  "family_identity": {
    "family_id": "SHEAR_OVERDESIGN_GOVERNS",
    "package": "design_brain.families.shear_overdesign_governs",
    "public_api": "run_shear_overdesign_governs_runtime"
  },
  "classification": {
    "entry_condition": "shear compliant with unnecessary shear reinforcement or outside efficiency target band",
    "governs_when": [
      "shear compliant",
      "reduction opportunity exists",
      "no underdesign family active",
      "outside efficiency target band OR unnecessary shear reinforcement exists"
    ],
    "must_not_govern_when": [
      "bending underdesign governs",
      "shear underdesign governs",
      "combined bending and shear underdesign governs",
      "serviceability failure governs",
      "geometry/detailing failure governs",
      "locked-no-repair outcome is required"
    ],
    "allowed_competing_families": [
      "BENDING_OVERDESIGN_GOVERNS",
      "COMBINED_OVERDESIGN",
      "TARGET_BAND_REACHED",
      "EXACT_STOP_PROVEN",
      "LOCKED_NO_REPAIR"
    ]
  },
  "zero_shear_override": {
    "purpose": "Do not suppress shear cleanup solely because shear demand/utilisation is zero when removable ligatures exist.",
    "activates_when": [
      "V* = 0 or negligible",
      "ligatures exist",
      "beam contains design actions"
    ],
    "requires": {
      "negligible_shear_action": true,
      "ligatures_exist": true,
      "design_actions_present": true
    },
    "must_not": [
      "terminate solely because utilisation is zero",
      "skip ligature removal while active ligatures exist",
      "treat zero shear as target-band complete before checking removable ligatures"
    ],
    "family_cannot_terminate_solely_because_utilisation_is_zero": true
  },
  "required_family_inputs": {
    "geometry": [
      "beam width",
      "beam depth",
      "effective depth",
      "geometry locked status"
    ],
    "reinforcement": [
      "ligature spacing",
      "ligature diameter",
      "ligature leg count",
      "ligature active/inactive state",
      "reinforcement locked status"
    ],
    "material_properties": [
      "concrete strength",
      "steel strength",
      "shear capacity parameters"
    ],
    "actions": [
      "design shear action",
      "torsion action",
      "bending action",
      "design actions present flag"
    ],
      "constraints": [
        "target utilisation band",
        "minimum practical ligature spacing",
        "minimum ligature diameter",
        "minimum leg count",
        "width reduction increment",
        "minimum practical width",
        "depth reduction prohibited",
        "locked/no-repair conditions"
      ]
  },
  "family_result_schema": {
    "result_type": "FamilyResult",
    "required_fields": [
      "status",
      "selected_recommendation",
      "candidate_repairs",
      "exhausted_reason",
      "evidence"
    ],
    "evidence_required_fields": [
      "entry_condition",
      "ladder_trace",
      "accepted_lane_evidence",
      "rejected_lane_evidence",
      "ranking_evidence",
      "zero_shear_override_evidence",
      "geometry_restriction_evidence",
      "terminal_status",
      "contract_version"
    ]
  },
  "internal_strategy_ladder": {
    "family_id": "SHEAR_OVERDESIGN_GOVERNS",
    "entry_condition": "shear compliant with unnecessary shear reinforcement or outside efficiency target band",
    "lanes": [
      {
        "lane_index": 0,
        "lane_id": "SPACING_INCREASE",
        "title": "Spacing increase",
        "purpose": "Reduce shear reinforcement density by increasing ligature spacing while preserving compliance.",
        "required_evidence": [
          "spacing before",
          "spacing after",
          "shear utilisation before",
          "shear utilisation after",
          "spacing/detailing status"
        ],
        "allowed_update_keys": [
          "s_lig"
        ],
        "failure_transition": "BAR_SIZE_REDUCTION"
      },
      {
        "lane_index": 1,
        "lane_id": "BAR_SIZE_REDUCTION",
        "title": "Bar-size reduction",
        "purpose": "Reduce ligature diameter where spacing increase is blocked or insufficient.",
        "required_evidence": [
          "diameter before",
          "diameter after",
          "shear utilisation before",
          "shear utilisation after",
          "bar size/detailing status"
        ],
        "allowed_update_keys": [
          "lig_d"
        ],
        "failure_transition": "LEG_COUNT_REDUCTION"
      },
      {
        "lane_index": 2,
        "lane_id": "LEG_COUNT_REDUCTION",
        "title": "Leg-count reduction",
        "purpose": "Reduce ligature leg count where spacing and diameter reductions are blocked or insufficient.",
        "required_evidence": [
          "leg count before",
          "leg count after",
          "shear utilisation before",
          "shear utilisation after",
          "constructability status"
        ],
        "allowed_update_keys": [
          "lig_legs"
        ],
        "failure_transition": "LIGATURE_REMOVAL"
      },
      {
        "lane_index": 3,
        "lane_id": "LIGATURE_REMOVAL",
        "title": "Ligature removal",
        "purpose": "Remove ligatures only when no-link shear design is code-valid, including zero/negligible shear with active ligatures.",
        "required_evidence": [
          "V* or negligible shear action status",
          "ligatures exist before",
          "no-link code allowance",
          "canonical no-link state",
          "shear utilisation after"
        ],
        "allowed_update_keys": [
          "lig_legs",
          "lig_d",
          "s_lig"
        ],
        "zero_shear_override_lane": true,
        "failure_transition": "WIDTH_REDUCTION"
      },
      {
        "lane_index": 4,
        "lane_id": "WIDTH_REDUCTION",
        "title": "Width reduction",
        "purpose": "Reduce unnecessary beam width after shear detailing cleanup while preserving bending, shear, detailing, fit, serviceability, and geometry constraints.",
        "required_evidence": [
          "width before",
          "width after",
          "width increment",
          "bending utilisation after",
          "shear utilisation after",
          "reinforcement rearrangement attempted",
          "bar fit and clear spacing status",
          "ligature fit and cover status",
          "serviceability status",
          "geometry constraint status"
        ],
        "allowed_update_keys": [
          "b",
          "bw",
          "beam_width",
          "beam_width_mm"
        ],
        "restart_proof_required": [
          "full reinforcement arrangement rebuilt",
          "bar positions and layers regenerated",
          "clear spacing recalculated",
          "alternative safe reinforcement arrangement searched when current arrangement does not fit",
          "complete design state recomputed"
        ],
        "failure_transition": "EXACT_STOP"
      },
      {
        "lane_index": 5,
        "lane_id": "EXACT_STOP",
        "title": "Exact stop",
        "purpose": "Stop when the current or best available shear cleanup state is already justified and no safe improvement remains.",
        "required_evidence": [
          "target-band status",
          "no unnecessary ligatures remain status",
          "width reduction attempted or locked",
          "smallest safe width",
          "next width blocker",
          "exhausted lane evidence"
        ],
        "output": "EXACT_STOP",
        "failure_transition": "EXHAUSTED"
      },
      {
        "lane_index": 6,
        "lane_id": "EXHAUSTED",
        "title": "Exhausted",
        "purpose": "Prove all legal shear cleanup lanes were attempted or blocked.",
        "required_evidence": [
          "attempted lane list",
          "blocked lane list",
          "exhausted reason"
        ],
        "output": "EXHAUSTED"
      }
    ],
    "ranking": {
      "ordered_criteria": [
        "smallest valid width",
        "target band achieved",
        "no unnecessary ligatures remain",
        "least reinforcement quantity",
        "least unnecessary geometry",
        "constructability",
        "cost proxy"
      ]
    },
    "required_outputs": [
      "status",
      "selected_recommendation",
      "candidate_repairs",
      "exhausted_reason",
      "evidence"
    ],
    "global_family_rules": [
      "candidate updates are restricted to shear-detailing keys or width-reduction keys only",
      "depth reduction is prohibited",
      "width reduction is required when geometry is unlocked and shear remains heavily under-utilised after shear detailing cleanup",
      "every width candidate rebuilds the full reinforcement arrangement and recomputes all checks",
      "zero-shear with existing ligatures must still run cleanup eligibility",
      "shared CTA/publication/apply/UI/session/source-precedence layers remain outside the family"
    ]
  },
  "geometry_restrictions": {
    "width_reduction_required_when_unlocked": true,
    "depth_reduction_prohibited": true,
    "prohibited_update_keys": [
      "D",
      "beam_depth",
      "beam_depth_mm"
    ],
    "prohibited_actions": [
      "depth reduction",
      "depth cleanup as shear-overdesign strategy"
    ],
    "allowed_update_keys": [
      "s_lig",
      "lig_d",
      "lig_legs",
      "b",
      "bw",
      "beam_width",
      "beam_width_mm"
    ]
  },
  "lane_proof_policies": {
    "spacing_increase": {
      "lane_id": "SPACING_INCREASE",
      "spacing_search_mm": [
        100,
        125,
        150,
        175,
        200,
        250,
        300
      ],
      "allowed_update_keys": [
        "s_lig"
      ]
    },
    "bar_size_reduction": {
      "lane_id": "BAR_SIZE_REDUCTION",
      "bar_size_search": [
        "N16",
        "N12",
        "N10"
      ],
      "restarts_spacing_search": true
    },
    "leg_count_reduction": {
      "lane_id": "LEG_COUNT_REDUCTION",
      "leg_count_search": [
        6,
        4,
        2
      ],
      "restarts_spacing_search": true,
      "restarts_bar_size_search": true
    },
    "ligature_removal": {
      "lane_id": "LIGATURE_REMOVAL",
      "allowed_when": [
        "no code minimum reinforcement requirement exists",
        "shear demand does not require ligatures"
      ],
      "preferred_for": [
        "V* = 0",
        "negligible shear demand"
      ],
      "canonical_update": {
        "lig_legs": 0,
        "lig_d": 0,
        "s_lig": 0
      }
    },
    "width_reduction": {
      "lane_id": "WIDTH_REDUCTION",
      "width_step_mm": 25,
      "minimum_width_mm": 200,
      "allowed_update_keys": [
        "b",
        "bw",
        "beam_width",
        "beam_width_mm"
      ],
      "requires_geometry_unlocked": true,
      "restarts_full_reinforcement_search": true,
      "must_recompute": [
        "bending capacity/utilisation",
        "shear capacity/utilisation",
        "minimum bending reinforcement",
        "minimum shear reinforcement",
        "ductility / neutral-axis ratio",
        "crack control",
        "deflection where supplied",
        "bar fit and clear spacing",
        "ligature fit and cover",
        "geometry ratio and minimum width rules",
        "family-specific target-band rule"
      ],
      "blocked_by": [
        "next width step fails bending",
        "next width step fails shear",
        "minimum reinforcement governs",
        "ductility governs",
        "serviceability governs",
        "reinforcement cannot fit after allowed rearrangement search",
        "minimum width/detailing constraint governs",
        "geometry ratio limit governs",
        "width is locked"
      ]
    },
    "terminal": {
      "exact_stop_allowed_when": [
        "target band reached",
        "no unnecessary ligatures remain and width reduction is exhausted or locked",
        "smallest safe width proven"
      ],
      "exhausted_requires": [
        "all optimisation branches attempted",
        "no further compliant reduction exists"
      ],
      "zero_shear_exhausted_forbidden_while_ligatures_remain_without_code_requirement": true
    },
    "zero_shear": {
      "case_a": {
        "V*": 0,
        "ligatures_present": true,
        "expected": "family activates"
      },
      "case_b": {
        "V*": 0,
        "ligatures_present": true,
        "code_minimum_required": false,
        "expected": "remove ligatures"
      },
      "case_c": {
        "V*": 0,
        "ligatures_present": false,
        "expected": "no optimisation required"
      }
    },
    "geometry_restriction": {
      "requires_width_reduction": true,
      "prohibits_depth_reduction": true,
      "allowed_update_keys": [
        "s_lig",
        "lig_d",
        "lig_legs",
        "b",
        "bw",
        "beam_width",
        "beam_width_mm"
      ]
    }
  },
  "terminal_rules": {
    "exact_stop": {
      "required": true,
      "allowed_when": [
        "target band achieved",
        "no unnecessary ligatures remain and width reduction exhausted or locked",
        "all safe shear cleanup lanes are exhausted"
      ]
    },
    "exhausted": {
      "required": true,
      "allowed_when": [
        "all spacing, bar-size, leg-count, and ligature-removal lanes are attempted or blocked",
        "no candidate preserves compliance",
        "locked constraints prohibit remaining repairs"
      ]
    }
  },
  "blockers": {
    "allowed": [
      "shear_not_compliant",
      "underdesign_family_active",
      "no_reduction_opportunity",
      "geometry_reduction_prohibited",
      "reinforcement_locked",
      "no_link_design_not_code_valid",
      "spacing_detailing_blocked",
      "width_locked",
      "width_reduction_exhausted",
      "next_width_step_failed_bending",
      "next_width_step_failed_shear",
      "reinforcement_cannot_fit_after_rearrangement",
      "no_safe_shear_cleanup_candidate"
    ],
    "not_top_level_families": [
      "zero_shear_no_links",
      "spacing_cleanup_blocked",
      "ligature_removal_blocked"
    ]
  },
  "shared_exclusions": [
    "CTA rendering",
    "CTA source precedence",
    "publication",
    "selected-family publication gate",
    "apply routing",
    "one-click orchestration",
    "visible wording",
    "user wording",
    "UI rendering",
    "session state",
    "debug rendering",
    "source precedence"
  ],
  "lock_verification": {
    "required_gates": [
      "SHEAR_OVERDESIGN_GOVERNS contract check",
      "shear overdesign candidate evaluation boundary",
      "zero-shear override proof",
      "geometry restriction proof",
      "lane snapshots",
      "runtime snapshot",
      "cutover verifier",
      "lock verifier"
    ],
    "required_verifiers": [
      "tools/verification/families/shear_overdesign_governs_contract_check.py"
    ]
  }
}
