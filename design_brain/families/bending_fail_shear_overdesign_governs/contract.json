{
  "schema": "design_brain.family_contract.v1",
  "family_identity": {
    "family_id": "BENDING_FAIL_SHEAR_OVERDESIGN_GOVERNS",
    "runtime_family_id": "BENDING_FAIL_SHEAR_OVERDESIGN_GOVERNS",
    "package": "design_brain.families.bending_fail_shear_overdesign_governs",
    "runtime_module": "design_brain.families.bending_fail_shear_overdesign_governs.runtime",
    "public_api": "evaluate_bending_fail_shear_overdesign_governs"
  },
  "selection_boundary": {
    "starts_after": "SelectedFamily == BENDING_FAIL_SHEAR_OVERDESIGN_GOVERNS",
    "runtime_may_assume": [
      "bending underdesign exists",
      "shear overdesign exists",
      "this is the selected governing mixed family"
    ],
    "must_not": [
      "perform classification",
      "choose another family",
      "override family selection",
      "perform family arbitration"
    ],
    "owned_by_shared_family_chooser": [
      "family selection",
      "family arbitration",
      "family priority"
    ]
  },
  "entry_contract": {
    "selected_family_id": "BENDING_FAIL_SHEAR_OVERDESIGN_GOVERNS",
    "requires": [
      "bending underdesign exists",
      "shear overdesign exists",
      "BENDING_FAIL_SHEAR_OVERDESIGN_GOVERNS has been selected"
    ],
    "validate_inputs_without_reclassification": true
  },
  "inputs_contract": {
    "input_type": "BendingFailShearOverdesignInputs",
    "required_groups": [
      "geometry",
      "reinforcement",
      "material_properties",
      "actions",
      "constraints",
      "bending_fail_candidates",
      "shear_overdesign_candidates"
    ],
    "forbidden_state": [
      "session state",
      "UI state",
      "publication state",
      "CTA state",
      "family chooser state except already-selected family identity"
    ]
  },
  "family_result_schema": {
    "result_type": "FamilyResult",
    "required_fields": [
      "status",
      "selected_recommendation",
      "candidate_repairs",
      "exhausted_reason",
      "evidence"
    ],
    "evidence_required_fields": [
      "selection_boundary",
      "candidate_source_proof",
      "mixed_merge_trace",
      "accepted_candidate_evidence",
      "rejected_candidate_evidence",
      "ranking_evidence",
      "exact_stop_proof",
      "exhausted_proof",
      "ownership_proof",
      "contract_version"
    ]
  },
  "ownership_contract": {
    "mixed_family_owns": [
      "candidate merge",
      "candidate ranking",
      "recommendation selection",
      "mixed-family exact stop proof",
      "mixed-family exhausted proof",
      "mixed-family evidence"
    ],
    "mixed_family_must_not_own": [
      "bending repair ladder",
      "shear optimisation ladder",
      "bending candidate generation",
      "shear candidate generation",
      "family selection",
      "family arbitration",
      "publication",
      "CTA generation",
      "CTA rendering",
      "apply routing",
      "session state",
      "UI rendering",
      "recommendation publication",
      "source precedence",
      "user wording"
    ],
    "bending_fail_governs_owns": [
      "bending repair ladder",
      "bending candidate generation",
      "bending repair evidence"
    ],
    "shear_overdesign_governs_owns": [
      "shear optimisation ladder",
      "shear candidate generation",
      "shear optimisation evidence"
    ],
    "shared_systems_own": [
      "family selection",
      "family arbitration",
      "publication",
      "CTA generation",
      "CTA rendering",
      "apply routing",
      "one-click orchestration",
      "session state",
      "UI rendering",
      "recommendation publication",
      "source precedence",
      "visible wording",
      "user wording",
      "debug rendering"
    ]
  },
  "candidate_source_contract": {
    "allowed_sources": [
      "BENDING_FAIL_GOVERNS",
      "SHEAR_OVERDESIGN_GOVERNS",
      "APPROVED_MIXED_MERGE_RULE"
    ],
    "must_not_duplicate_ladders": true,
    "mandatory_source": "BENDING_FAIL_GOVERNS",
    "opportunistic_source": "SHEAR_OVERDESIGN_GOVERNS",
    "approved_merge_rules": [
      "combine one bending-fail repair candidate with one shear-overdesign optimisation candidate",
      "use a bending repair candidate alone when shear optimisation would compromise the repair",
      "use explicit shared update keys from source candidates without inventing formula ladders"
    ],
    "forbidden_sources": [
      "internally generated bending repair ladder",
      "internally generated shear optimisation ladder",
      "page-local publication candidates",
      "CTA payload candidates",
      "UI/session candidates"
    ]
  },
  "priority_contract": {
    "mandatory_objective": "bending repair",
    "opportunistic_objective": "shear optimisation",
    "rules": [
      "repairing bending failure is mandatory",
      "shear optimisation is secondary",
      "never leave bending underdesign unresolved to reduce shear reinforcement",
      "additional shear reinforcement may be accepted when required for valid bending repair"
    ]
  },
  "success_contract": {
    "valid_mixed_recommendation_requires": [
      "bending becomes compliant",
      "shear remains compliant",
      "code compliance maintained",
      "constructability maintained"
    ],
    "must_not_accept": [
      "candidate leaves bending underdesign unresolved",
      "candidate creates shear underdesign",
      "candidate violates code compliance",
      "candidate violates constructability"
    ]
  },
  "shear_protection": {
    "shear_capacity_ratio_min": 1.0,
    "invalid_before_ranking": [
      "phiVu / Vstar < 1.00",
      "candidate creates shear underdesign"
    ]
  },
  "target_band": {
    "bending_lower": 0.85,
    "bending_upper": 1.0,
    "shear_lower": 0.85,
    "shear_upper": 1.0,
    "candidate_lane": "BENDING_FAIL_SHEAR_OVERDESIGN_TARGET_BAND_FALLBACK_PROOF",
    "preferred": "bending repaired and shear remains compliant; shear moves closer to target band where possible",
    "fallback": "best bending-compliant repair with specific shear optimisation blocker evidence"
  },
  "interaction_contract": {
    "geometry_update_keys": [
      "D",
      "beam_depth",
      "beam_depth_mm",
      "b",
      "bw",
      "beam_width",
      "beam_width_mm"
    ],
    "bending_reinforcement_update_keys": [
      "bot1_count",
      "db_bot_1",
      "bot2_count",
      "db_bot_2",
      "bot_row_count",
      "bot_row_1_bars",
      "bot_row_1_dia",
      "bot_row_2_bars",
      "bot_row_2_dia"
    ],
    "shear_reinforcement_update_keys": [
      "lig_d",
      "lig_legs",
      "s_lig"
    ],
    "geometry_recheck_required": [
      "bending",
      "shear",
      "minimum reinforcement",
      "geometry limits",
      "constructability"
    ]
  },
  "exact_stop": {
    "allowed_when": [
      "bending compliant",
      "shear compliant",
      "no higher-ranked candidate exists",
      "further shear optimisation would compromise the preferred bending repair"
    ]
  },
  "exhausted": {
    "requires": [
      "all bending repair candidates attempted",
      "all shear optimisation candidates attempted",
      "all approved merge candidates attempted",
      "no valid recommendation exists",
      "specific blocker exists"
    ],
    "valid_reasons": [
      "bending repair exhausted",
      "shear optimisation would compromise bending repair",
      "shear underdesign protection boundary",
      "geometry constraint boundary",
      "constructability boundary",
      "code compliance boundary"
    ],
    "generic_exhausted_message_prohibited_when_specific_blocker_exists": true
  },
  "ranking": {
    "ordered_criteria": [
      "repairs bending failure",
      "maintains shear compliance",
      "bending utilisation closest to target band",
      "shear utilisation closest to target band",
      "smallest geometry increase",
      "smallest reinforcement increase",
      "constructability",
      "cost proxy"
    ],
    "invalid_before_ranking": [
      "candidate leaves bending underdesign unresolved",
      "candidate creates shear underdesign",
      "candidate violates code compliance",
      "candidate violates constructability"
    ]
  },
  "evidence_contract": {
    "required": [
      "why mixed family was selected",
      "which bending failure was repaired",
      "which shear optimisation opportunity existed",
      "why selected candidate was preferred",
      "why alternatives were rejected",
      "whether exact stop or exhausted occurred"
    ],
    "must_not_contain": [
      "CTA wording",
      "UI wording"
    ]
  },
  "lane_proof_policies": {
    "candidate_source": {
      "allowed_sources": [
        "BENDING_FAIL_GOVERNS",
        "SHEAR_OVERDESIGN_GOVERNS",
        "APPROVED_MIXED_MERGE_RULE"
      ],
      "forbidden": [
        "mixed family generated bending repair ladder",
        "mixed family generated shear optimisation ladder"
      ]
    },
    "priority": {
      "mandatory": "bending repair",
      "opportunistic": "shear optimisation",
      "case_a": {
        "candidate": "repairs bending and improves shear optimisation",
        "expected": "candidate may be ranked"
      },
      "case_b": {
        "candidate": "improves shear optimisation but leaves bending underdesign",
        "expected": "candidate rejected before ranking"
      },
      "case_c": {
        "candidate": "repairs bending but cannot reduce shear reinforcement safely",
        "expected": "candidate may still be selected"
      }
    },
    "shear_protection": {
      "case_d": {
        "candidate": "creates shear underdesign",
        "expected": "candidate rejected before ranking"
      }
    },
    "terminal": {
      "exact_stop_allowed_when": [
        "bending compliant",
        "shear compliant",
        "no higher-ranked candidate exists",
        "further shear optimisation would compromise the preferred bending repair"
      ],
      "exhausted_requires": [
        "all bending repair candidates attempted",
        "all shear optimisation candidates attempted",
        "all approved merge candidates attempted",
        "no valid recommendation exists",
        "specific blocker exists"
      ]
    },
    "target_band_refinement": {
      "lane_id": "BENDING_FAIL_SHEAR_OVERDESIGN_TARGET_BAND_FALLBACK_PROOF",
      "preferred": "bending repaired and shear remains compliant with shear moving closer to target band where possible",
      "fallback": "best bending-compliant repair with specific shear optimisation blocker evidence",
      "fallback_requires_specific_blocker": true,
      "runtime_must_report_target_band_candidate_count": true,
      "runtime_must_report_selected_target_band_status": true
    }
  },
  "shared_exclusions": [
    "family selection",
    "family arbitration",
    "publication",
    "CTA generation",
    "CTA rendering",
    "apply routing",
    "one-click orchestration",
    "session state",
    "UI rendering",
    "recommendation publication",
    "source precedence",
    "visible wording",
    "user wording",
    "debug rendering"
  ],
  "lock_verification": {
    "required_verifiers": [
      "tools/verification/families/bending_fail_shear_overdesign_governs_contract_check.py"
    ],
    "required_gates": [
      "BENDING_FAIL_SHEAR_OVERDESIGN_GOVERNS contract check",
      "mixed candidate merge boundary",
      "mixed source and priority proofs",
      "mixed runtime snapshot",
      "replacement audit",
      "cutover plan",
      "cutover implementation",
      "live wiring snapshot",
      "lock verifier"
    ]
  }
