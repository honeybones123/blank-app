{
  "schema": "design_brain.family_contract.v1",
  "family_identity": {
    "family_id": "SHEAR_FAIL_BENDING_OVERDESIGN_GOVERNS",
    "runtime_family_id": "SHEAR_FAIL_BENDING_OVERDESIGN_GOVERNS",
    "package": "design_brain.families.shear_fail_bending_overdesign_governs",
    "runtime_module": "design_brain.families.shear_fail_bending_overdesign_governs.runtime",
    "public_api": "evaluate_shear_fail_bending_overdesign_governs"
  },
  "selection_boundary": {
    "starts_after": "SelectedFamily == SHEAR_FAIL_BENDING_OVERDESIGN_GOVERNS",
    "runtime_may_assume": [
      "shear underdesign exists",
      "bending overdesign exists",
      "this is the selected governing mixed family"
    ],
    "must_not": [
      "perform classification",
      "choose another family",
      "override family selection",
      "perform family arbitration"
    ],
    "owned_by_shared_family_chooser": [
      "family selection",
      "family arbitration",
      "family priority"
    ]
  },
  "entry_contract": {
    "selected_family_id": "SHEAR_FAIL_BENDING_OVERDESIGN_GOVERNS",
    "requires": [
      "shear underdesign exists",
      "bending overdesign exists",
      "SHEAR_FAIL_BENDING_OVERDESIGN_GOVERNS has been selected"
    ],
    "validate_inputs_without_reclassification": true
  },
  "inputs_contract": {
    "input_type": "ShearFailBendingOverdesignInputs",
    "required_groups": [
      "geometry",
      "reinforcement",
      "material_properties",
      "actions",
      "constraints",
      "shear_fail_candidates",
      "bending_overdesign_candidates"
    ],
    "forbidden_state": [
      "session state",
      "UI state",
      "publication state",
      "CTA state",
      "family chooser state except already-selected family identity"
    ]
  },
  "family_result_schema": {
    "result_type": "FamilyResult",
    "required_fields": [
      "status",
      "selected_recommendation",
      "candidate_repairs",
      "exhausted_reason",
      "evidence"
    ],
    "evidence_required_fields": [
      "selection_boundary",
      "candidate_source_proof",
      "mixed_merge_trace",
      "accepted_candidate_evidence",
      "rejected_candidate_evidence",
      "ranking_evidence",
      "exact_stop_proof",
      "exhausted_proof",
      "ownership_proof",
      "contract_version"
    ]
  },
  "ownership_contract": {
    "mixed_family_owns": [
      "candidate merge",
      "candidate ranking",
      "recommendation selection",
      "mixed-family exact stop proof",
      "mixed-family exhausted proof",
      "mixed-family evidence"
    ],
    "mixed_family_must_not_own": [
      "shear repair ladder",
      "bending optimisation ladder",
      "shear candidate generation",
      "bending candidate generation",
      "family selection",
      "family arbitration",
      "publication",
      "CTA generation",
      "CTA rendering",
      "apply routing",
      "session state",
      "UI rendering",
      "recommendation publication",
      "source precedence",
      "user wording"
    ],
    "shear_fail_governs_owns": [
      "shear repair ladder",
      "shear candidate generation",
      "shear repair evidence"
    ],
    "bending_overdesign_governs_owns": [
      "bending optimisation ladder",
      "bending candidate generation",
      "bending optimisation evidence"
    ],
    "shared_systems_own": [
      "family selection",
      "family arbitration",
      "publication",
      "CTA generation",
      "CTA rendering",
      "apply routing",
      "one-click orchestration",
      "session state",
      "UI rendering",
      "recommendation publication",
      "source precedence",
      "visible wording",
      "user wording",
      "debug rendering"
    ]
  },
  "candidate_source_contract": {
    "allowed_sources": [
      "SHEAR_FAIL_GOVERNS",
      "BENDING_OVERDESIGN_GOVERNS",
      "APPROVED_MIXED_MERGE_RULE"
    ],
    "must_not_duplicate_ladders": true,
    "mandatory_source": "SHEAR_FAIL_GOVERNS",
    "opportunistic_source": "BENDING_OVERDESIGN_GOVERNS",
    "approved_merge_rules": [
      "combine one shear-fail repair candidate with one bending-overdesign optimisation candidate",
      "use a shear repair candidate alone when bending optimisation would compromise the repair",
      "use explicit shared update keys from source candidates without inventing formula ladders"
    ],
    "forbidden_sources": [
      "internally generated shear repair ladder",
      "internally generated bending optimisation ladder",
      "page-local publication candidates",
      "CTA payload candidates",
      "UI/session candidates"
    ]
  },
  "priority_contract": {
    "mandatory_objective": "shear repair",
    "opportunistic_objective": "bending optimisation",
    "rules": [
      "repairing shear failure is mandatory",
      "bending optimisation is secondary",
      "never leave shear underdesign unresolved to reduce bending reinforcement",
      "additional bending reinforcement may be accepted when required for valid shear repair"
    ]
  },
  "success_contract": {
    "valid_mixed_recommendation_requires": [
      "shear becomes compliant",
      "bending remains compliant",
      "code compliance maintained",
      "constructability maintained"
    ],
    "must_not_accept": [
      "candidate leaves shear underdesign unresolved",
      "candidate creates bending underdesign",
      "candidate violates code compliance",
      "candidate violates constructability"
    ]
  },
  "bending_protection": {
    "bending_capacity_ratio_min": 1.0,
    "invalid_before_ranking": [
      "phiMu / Mstar < 1.00",
      "candidate creates bending underdesign"
    ]
  },
  "target_band": {
    "bending_lower": 0.85,
    "bending_upper": 1.0,
    "shear_lower": 0.85,
    "shear_upper": 1.0,
    "preferred": "shear repaired and bending remains compliant; bending moves closer to target band where possible",
    "fallback": "best shear-compliant repair with specific bending optimisation blocker evidence"
  },
  "interaction_contract": {
    "geometry_update_keys": [
      "D",
      "beam_depth",
      "beam_depth_mm",
      "b",
      "bw",
      "beam_width",
      "beam_width_mm"
    ],
    "bending_reinforcement_update_keys": [
      "bot1_count",
      "db_bot_1",
      "bot2_count",
      "db_bot_2",
      "bot_row_count",
      "bot_row_1_bars",
      "bot_row_1_dia",
      "bot_row_2_bars",
      "bot_row_2_dia"
    ],
    "shear_reinforcement_update_keys": [
      "lig_d",
      "lig_legs",
      "s_lig"
    ],
    "geometry_recheck_required": [
      "bending",
      "shear",
      "minimum reinforcement",
      "geometry limits",
      "constructability"
    ]
  },
  "exact_stop": {
    "allowed_when": [
      "shear compliant",
      "bending compliant",
      "no higher-ranked candidate exists",
      "further bending optimisation would compromise the preferred shear repair"
    ]
  },
  "exhausted": {
    "requires": [
      "all shear repair candidates attempted",
      "all bending optimisation candidates attempted",
      "all approved merge candidates attempted",
      "no valid recommendation exists",
      "specific blocker exists"
    ],
    "valid_reasons": [
      "shear repair exhausted",
      "bending optimisation would compromise shear repair",
      "bending underdesign protection boundary",
      "geometry constraint boundary",
      "constructability boundary",
      "code compliance boundary"
    ],
    "generic_exhausted_message_prohibited_when_specific_blocker_exists": true
  },
  "ranking": {
    "ordered_criteria": [
      "repairs shear failure",
      "maintains bending compliance",
      "shear utilisation closest to target band",
      "bending utilisation closest to target band",
      "smallest geometry increase",
      "smallest reinforcement increase",
      "constructability",
      "cost proxy"
    ],
    "invalid_before_ranking": [
      "candidate leaves shear underdesign unresolved",
      "candidate creates bending underdesign",
      "candidate violates code compliance",
      "candidate violates constructability"
    ]
  },
  "evidence_contract": {
    "required": [
      "why mixed family was selected",
      "which shear failure was repaired",
      "which bending optimisation opportunity existed",
      "why selected candidate was preferred",
      "why alternatives were rejected",
      "whether exact stop or exhausted occurred"
    ],
    "must_not_contain": [
      "CTA wording",
      "UI wording"
    ]
  },
  "lane_proof_policies": {
    "candidate_source": {
      "allowed_sources": [
        "SHEAR_FAIL_GOVERNS",
        "BENDING_OVERDESIGN_GOVERNS",
        "APPROVED_MIXED_MERGE_RULE"
      ],
      "forbidden": [
        "mixed family generated shear repair ladder",
        "mixed family generated bending optimisation ladder"
      ]
    },
    "priority": {
      "mandatory": "shear repair",
      "opportunistic": "bending optimisation",
      "case_a": {
        "candidate": "repairs shear and improves bending optimisation",
        "expected": "candidate may be ranked"
      },
      "case_b": {
        "candidate": "improves bending optimisation but leaves shear underdesign",
        "expected": "candidate rejected before ranking"
      },
      "case_c": {
        "candidate": "repairs shear but cannot reduce bending reinforcement safely",
        "expected": "candidate may still be selected"
      }
    },
    "bending_protection": {
      "case_d": {
        "candidate": "creates bending underdesign",
        "expected": "candidate rejected before ranking"
      }
    },
    "terminal": {
      "exact_stop_allowed_when": [
        "shear compliant",
        "bending compliant",
        "no higher-ranked candidate exists",
        "further bending optimisation would compromise the preferred shear repair"
      ],
      "exhausted_requires": [
        "all shear repair candidates attempted",
        "all bending optimisation candidates attempted",
        "all approved merge candidates attempted",
        "no valid recommendation exists",
        "specific blocker exists"
      ]
    }
  },
  "shared_exclusions": [
    "family selection",
    "family arbitration",
    "publication",
    "CTA generation",
    "CTA rendering",
    "apply routing",
    "one-click orchestration",
    "session state",
    "UI rendering",
    "recommendation publication",
    "source precedence",
    "visible wording",
    "user wording",
    "debug rendering"
  ],
  "lock_verification": {
    "required_verifiers": [
      "tools/verification/families/shear_fail_bending_overdesign_governs_contract_check.py"
    ],
    "required_gates": [
      "SHEAR_FAIL_BENDING_OVERDESIGN_GOVERNS contract check",
      "mixed candidate merge boundary",
      "mixed source and priority proofs",
      "mixed runtime snapshot",
      "replacement audit",
      "cutover plan",
      "cutover implementation",
      "live wiring snapshot",
      "lock verifier"
    ]
  }
}
