        "blocker_reasons": [
          "clear_spacing_below_100_mm"
        ],
        "no_candidate_stop_reason": "geometry locked; legal no-repair proof required if contract runtime candidates fail"
      }
    },
    "ranking_rule": "Evaluate contract runtime lane order and stop immediately on the first fully compliant executor-backed pure bending repair."
  },
  "blockers": {
    "allowed": [
      "min_bending_reo",
      "spacing",
      "ductility",
      "geometry_detailing",
