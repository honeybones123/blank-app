{
  "schema": "design_brain.cta_button_contract.v1",
  "contract_identity": {
    "contract_id": "DESIGN_GUIDE_CTA_BUTTON_SOURCE_PRECEDENCE",
    "owner": "design_brain/contracts",
    "live_resolver": "inputs_page._resolve_design_guide_button_contract_source_precedence",
    "source_records": "inputs_page.DesignGuideButtonContractSourceRecords",
    "source_resolution": "inputs_page.DesignGuideButtonContractSourceResolution"
  },
  "source_precedence": {
    "button_contract": [
      "primary.button_contract",
      "debug.displayed_primary_button_contract",
      "debug.primary_button_contract",
      "debug.button_contract"
    ],
    "candidate_source_keys": [
      "item_contract",
      "debug_displayed_primary_button_contract",
      "debug_primary_button_contract",
      "debug_button_contract",
      "session_primary_contract",
      "evidence_rehydration_source",
      "intent_row_fallback_source",
      "publication_recovery_source"
    ],
    "focused_scenario_expected_winners": {
      "compute_contract_rebound": "evidence_rehydration_source",
      "publication_intent_row_fallback": "intent_row_fallback_source",
      "publication_recovery_snapshot": "publication_recovery_source"
    }
  },
  "payload_precedence": {
    "update_payload": [
      "winning_button_contract.updates",
      "final_item.selected_action_updates",
      "final_item.updates",
      "final_action_payload.updates",
      "final_action_payload.resolved_candidate_updates"
    ],
    "action_type": [
      "final_item.action_type",
      "winning_button_contract.action_type",
      "final_action_payload.action_type",
      "final_action_payload.resolved_candidate_action_type"
    ],
    "candidate": [
      "final_item.candidate_id",
      "final_item.source_candidate_id",
      "winning_button_contract.candidate_id",
      "winning_button_contract.source_candidate_id",
      "final_action_payload.candidate_id",
      "final_action_payload.source_candidate_id"
    ],
    "disabled_reason": [
      "winning_button_contract.blocking_reason",
      "winning_button_contract.disabled_reason",
      "apply_state.disabled_reason",
      "final_action_payload.disabled_reason"
    ],
    "source_payload_labels": {
      "evidence_rehydration_source": {
        "update_payload": "candidate_search_evidence.best_safe_candidate_updates",
        "action_type": "rebuilt_late_evidence_contract",
        "candidate": "candidate_search_evidence.selected_candidate_id"
      },
      "intent_row_fallback_source": {
        "update_payload": "intent_row_contract.updates",
        "action_type": "intent_row_contract.action_type",
        "candidate": "intent_row_contract.candidate_id"
      },
      "publication_recovery_source": {
        "update_payload": "publication_recovery_source.updates",
        "action_type": "publication_recovery_source.action_type",
        "candidate": "publication_recovery_source.candidate_id"
      },
      "item_contract": {
        "update_payload": "primary.button_contract.updates",
        "action_type": "primary.button_contract.action_type",
        "candidate": "primary.button_contract.candidate_id"
      },
      "debug_displayed_primary_button_contract": {
        "update_payload": "debug.displayed_primary_button_contract.updates",
        "action_type": "debug.displayed_primary_button_contract.action_type",
        "candidate": "debug.displayed_primary_button_contract.candidate_id"
      },
      "debug_primary_button_contract": {
        "update_payload": "debug.primary_button_contract.updates",
        "action_type": "debug.primary_button_contract.action_type",
        "candidate": "debug.primary_button_contract.candidate_id"
      },
      "debug_button_contract": {
        "update_payload": "debug.button_contract.updates",
        "action_type": "debug.button_contract.action_type",
        "candidate": "debug.button_contract.candidate_id"
      },
      "session_primary_contract": {
        "update_payload": "session.primary_button_contract.updates",
        "action_type": "session.primary_button_contract.action_type",
        "candidate": "session.primary_button_contract.candidate_id"
      }
    }
  },
  "required_proof_fields": [
    "winning_button_contract",
    "winning_button_contract_source",
    "winning_update_payload",
    "winning_update_payload_source",
    "winning_action_type",
    "winning_action_type_source",
    "winning_candidate",
    "winning_candidate_source",
    "apply_enabled",
    "apply_actionable",
    "disabled_reason",
    "final_cta_action_payload_summary",
    "final_published_item_hash",
    "source_candidates"
  ],
  "required_source_record_fields": [
    "displayed_primary_item",
    "primary_item",
    "guidance_debug",
    "debug_displayed_primary_button_contract",
    "debug_primary_button_contract",
    "debug_button_contract",
    "pending_recommendation",
    "apply_payload_session_keys",
    "button_contract_session_keys",
    "action_payload_sources",
    "update_payload_sources",
    "candidate_sources",
    "publication_recovery_sources",
    "source_candidates"
  ],
  "allowed_cta_states": [
    "apply_enabled",
    "apply_disabled_with_reason",
    "no_apply_exact_stop",
    "no_apply_locked",
    "no_apply_no_candidate"
  ],
  "required_gates": [
    "CTA_source_precedence_snapshot",
    "compileall",
    "architecture_API_contract_checks",
    "locked_regressions",
    "publication_snapshot",
    "focused_SHEAR_boundary",
    "C1_C2_C3_product_gates",
    "SHEAR_COMBINED_BENDING_regressions",
    "targeted_fingerprint_update_resolution_scan"
  ],
  "movement_rules": {
    "json_contract_is_source_of_truth": true,
    "do_not_move_cta_logic_to_design_brain_contracts_yet": true,
    "source_collection_stays_page_local_until_split": true,
    "mutation_application_stays_page_local_until_split": true,
    "must_preserve_apply_enabled_disabled_state": true,
    "must_preserve_update_payload_source": true,
    "must_preserve_action_type_source": true,
    "must_preserve_candidate_source": true,
    "must_preserve_final_published_item_hash": true
  }
}
